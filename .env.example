# ─────────────────────────────────────────────
# 혼밥 지도 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요:  cp .env.example .env.local
# .env.local 은 git 에 올라가지 않습니다.
# ─────────────────────────────────────────────

# Supabase  (대시보드 > Project Settings > API)
#  - URL:  Project URL
#  - ANON_KEY: anon(public) 키 또는 새 형식의 publishable 키 (sb_publishable_...)
#  * 로컬 Supabase 사용 시: `npx supabase status` 출력의 API URL / anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 카카오맵 JavaScript 키  (developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키)
#  브라우저에 노출되는 키이므로, 카카오 콘솔의 [플랫폼 > Web 사이트 도메인]에
#  http://localhost:3000 과 배포 도메인만 등록해서 사용처를 제한하세요.
#  비워 두면 앱은 동작하고, 주소 검색·지도 자리에 "키를 넣어 주세요" 안내가 보입니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your-kakao-javascript-key

# 배포한 사이트 주소 (선택). 사장님 스티커 QR 코드가 가리킬 주소예요.
#  비워 두면 지금 접속한 주소(예: http://localhost:3000)를 써요 → 손님 휴대폰에서는 안 열리니 배포 후 꼭 넣으세요.
#  예: https://honbap.example.com  (끝에 / 없이)
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────
# 비밀 값 안내
#  - 카카오 로그인 Client Secret 은 이 파일이 아니라 Supabase 대시보드(Authentication > Providers > Kakao)에 넣는다.
#  - Supabase service_role(secret) 키는 지금 앱에서 쓰지 않는다. 나중에 필요해져도 .env.local 에만 두고
#    코드·채팅·GitHub 에 절대 올리지 않는다.
#  - 로컬 Supabase 에서 카카오 로그인을 시험할 때만 supabase/.env 에(git 에 안 올라감):
#      SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=<카카오 REST API 키>
#      SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=<카카오 로그인 Client Secret>
# ─────────────────────────────────────────────
