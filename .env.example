# ─────────────────────────────────────────────
# 혼밥 지도 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요:  cp .env.example .env.local
# .env.local 은 git 에 올라가지 않습니다.
# ─────────────────────────────────────────────

# Supabase  (대시보드 > Project Settings > API)
#  - URL:  Project URL
#  - ANON_KEY: anon(public) 키 또는 새 형식의 publishable 키 (sb_publishable_...)
#  * 로컬 Supabase 사용 시: `npx supabase status` 출력의 API URL / anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 카카오맵 JavaScript 키  (developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키)
#  브라우저에 노출되는 키이므로, 카카오 콘솔의 [플랫폼 > Web 사이트 도메인]에
#  http://localhost:3000 과 배포 도메인만 등록해서 사용처를 제한하세요.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your-kakao-javascript-key
