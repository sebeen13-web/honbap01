# ─────────────────────────────────────────────
# 혼밥 지도 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요:  cp .env.example .env.local
# .env.local 은 git 에 올라가지 않습니다.
# ─────────────────────────────────────────────

# Supabase  (대시보드 > Project Settings > API)
#  - URL:  Project URL
#  - ANON_KEY: anon(public) 키 또는 새 형식의 publishable 키 (sb_publishable_...)
#  * 로컬 Supabase 사용 시: `npx supabase status` 출력의 API URL / anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 카카오맵 JavaScript 키  (developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키)
#  브라우저에 노출되는 키이므로, 카카오 콘솔의 [플랫폼 > Web 사이트 도메인]에
#  http://localhost:3000 과 배포 도메인만 등록해서 사용처를 제한하세요.
#  비워 두면 앱은 동작하고, 주소 검색·지도 자리에 "키를 넣어 주세요" 안내가 보입니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your-kakao-javascript-key

# ─────────────────────────────────────────────
# 서버 전용 (NEXT_PUBLIC_ 이 아님 → 브라우저로 보내지지 않음)
# 4단계 "오늘도 됐어요 / 안 됐어요" API 에서 사용. 그 전에는 비워 둬도 된다.
# ⚠️ 이 두 값은 비밀입니다. GitHub 등 어디에도 올리지 마세요. (.env.local 은 git 에 올리지 않는 파일)
# ─────────────────────────────────────────────
# Supabase service_role(secret) 키  (대시보드 > Project Settings > API Keys)
#  * 로컬: `npx supabase status` 출력의 Secret key
SUPABASE_SERVICE_ROLE_KEY=
# 방문자 해시용 비밀 솔트. 32자 이상 임의 문자열 (예: 터미널에서 `openssl rand -hex 32`)
#  해시 = sha256(IP + User-Agent + 한국 날짜 + 이 솔트). 바꾸면 그날의 '하루 1회' 기록이 초기화된다.
CONFIRM_HASH_SALT=
